# ===============================================
# IaProTech Privacy Proxy - Environment Template
# ===============================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file.

# --- Security (CRITICAL) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_64_CHAR_HEX_STRING_HERE
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=GENERATE_FERNET_KEY_HERE

# --- LLM Provider Configuration ---
LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
MISTRAL_API_KEY=YOUR_MISTRAL_KEY_HERE

# --- Redis ---
REDIS_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD
REDIS_URL=redis://PASSWORD@redis:6379/0
REDIS_TTL_SECONDS=3600

# --- Auth & Rate Limiting ---
TOKEN_EXPIRE_MINUTES=60
MAX_REQUESTS_PER_MINUTE=60

# --- File Handling ---
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_TYPES=["pdf","docx","doc","xlsx","xls","pptx","ppt","odt","ods","odp","txt","csv","tsv","rtf","md","jpg","jpeg","png","gif","webp","bmp","tiff","tif","eml","msg","vtt","srt","html","htm","json","xml","yaml","yml"]

# --- Redaction ---
REDACTION_ENGINE=presidio
SUPPORTED_LANGUAGES=["fr","en","de","es","it","pt","nl"]

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Logging ---
DEBUG=false
LOG_LEVEL=INFO

# --- Features ---
ROUTER_ENABLED=true
BOOTSTRAP_ENABLED=true

# --- Development Only (disable in production!) ---
DEV_AUTO_CREATE_ADMIN=false
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=USE_A_REAL_STRONG_PASSWORD_NOT_A_SINGLE_CHAR
